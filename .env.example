

APP_ENV=prod
APP_DEBUG=1
APP_SECRET=change_me
DATABASE_HOST=db
DATABASE_PORT=3306
DATABASE_NAME=ludoplanet
DATABASE_USER=root
DATABASE_PASSWORD=root
MESSENGER_TRANSPORT_DSN=sync://

JWT_SECRET=change_me_jwt_secret
JWT_TTL=3600

# E-mails (Symfony Mailer). En local/Docker : Mailpit. En production : ton SMTP ou API (SendGrid, Mailgun, etc.).
# Envois actuels : inscription (lien confirmation), mot de passe oublié (lien reset), confirmation de commande après paiement.
# Docker/local : smtp://mailpit:1025 (interface Mailpit : http://localhost:8025)
# Production : ex. smtp://user:pass@smtp.example.com:587 ou dsn d’un fournisseur (voir doc Symfony Mailer)
MAILER_DSN=smtp://mailpit:1025
MAILER_FROM=no-reply@ludoplanet.local

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FRONTEND_URL=http://localhost:3503/

JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=

CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
